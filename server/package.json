{
  "name": "wampire-server",
  "version": "1.0.0",
  "description": "Backend API for WAMPIRE Hackathon Registration Portal",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test_server.js",
    "test:db": "node test_db_architecture.js",
    "test:auth": "node test_auth_flow.js",
    "test:email": "node test_email_delivery.js",
    "test:crud": "node test_crud_operations.js",
    "test:audit": "node test_end_to_end_audit.js",
    "test:prod": "node test_production_verification.js",
    "test:all": "node test_db_architecture.js && node test_auth_flow.js && node test_email_delivery.js && node test_server.js && node test_crud_operations.js && node test_end_to_end_audit.js && node test_production_verification.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "hackathon",
    "express",
    "mongodb",
    "jwt",
    "wampire"
  ],
  "author": "WAMPIRE Team",
