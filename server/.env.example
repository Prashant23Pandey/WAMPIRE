# ==============================================================================
# CODE-A-NOVA BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/code_a_nova?retryWrites=true&w=majority

# JWT Authentication Secret (Cryptographically random string, minimum 32 characters)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Gmail SMTP Email Configuration (Nodemailer)
# Use your Gmail address and a 16-character App Password (from Google Account > Security > 2FA > App Passwords)
EMAIL_USER=your-organization-email@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM_NAME=Code-a-Nova

# Client URL for Production CORS & Cookie Sharing
# Comma-separated list for multiple origins (e.g., custom domain + Vercel deployment)
CLIENT_URL=https://code-a-nova.vercel.app,http://localhost:5173
