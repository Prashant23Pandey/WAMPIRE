# ==============================================================================
# CODE-A-NOVA PRODUCTION & LOCAL DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to:
#   1. server/.env (for Backend on Render / Railway / Local)
#   2. client/.env (for Frontend on Vercel / Local)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Deploy on Render or Railway)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI (Do NOT commit real credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/code_a_nova?retryWrites=true&w=majority

# JWT Token Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_production_secure_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# Gmail SMTP Email System (Nodemailer)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_hackathon_gmail_address@gmail.com
EMAIL_PASS=your_16_digit_google_app_password
EMAIL_FROM_NAME=Code-a-Nova

# Allowed Frontend Origins (CORS & Cookie Whitelist, comma-separated)
CLIENT_URL=https://code-a-nova.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Deploy on Vercel)
# ------------------------------------------------------------------------------
# Points to the deployed backend API on Render or Railway
VITE_API_URL=https://code-a-nova-api.onrender.com/api
